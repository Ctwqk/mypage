# Copy to .env and export before starting the server, e.g.:
#   set -a; source .env; set +a; python server.py
# Never commit the real .env file.

# --- LLM: any OpenAI-compatible chat endpoint --------------------------------
# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=deepseek-llm:7b
LLM_API_KEY=
# DeepSeek hosted API:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=<your key>
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=<your key>
LLM_TIMEOUT=120

# --- Storage (relative paths are resolved against backpart/DeepSeek/) --------
DATABASE_PATH=data/chat.db
MEDIA_DIR=data/media

# --- Static front end served by Flask (empty string disables it) ------------
FRONTEND_DIR=../../frontpart

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_MESSAGE=4
MAX_MESSAGE_CHARS=50000
HISTORY_LIMIT=10

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
